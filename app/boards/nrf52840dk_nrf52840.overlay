/*
 * nRF52840DK dev-bench board. Auto-merged by Zephyr's board devicetree
 * overlay convention, like the nRF54L15DK's overlay.
 *
 * The control link is the native USB "EmbArch control" CDC ACM port, named by
 * the `embarch,control-link` chosen entry below (decision 62); the link
 * protocol on it is unchanged. The J-Link UART (`zephyr,console` is `&uart0`,
 * VCOM0 of the on-board J-Link) is no longer the link, but keeps its 1 Mbaud
 * and flow-control settings so a build that drops the chosen entry falls back
 * to the same link the nRF54L15DK uses. `uart0_default` carries RTS on P0.05 and CTS on P0.07 alongside TX P0.06 /
 * RX P0.08, so nothing is rewired.
 *
 * Analog source. The input is a devicetree node the analog-source code reads
 * (`DT_CHOSEN(embarch_analog_input)`), never a pin number in C. It is the
 * Arduino-header A0 pin, P0.03 = AIN1 (the DK's own `arduino_adc` map says
 * the same). The marker input is the DK's BUTTON2 (P0.12); BUTTON1 stays free
 * for the MCUboot recovery button (`mcuboot-button0`).
 *
 * The SAADC is taken by the analog source through nrfx directly (advanced
 * mode with its internal timer, which Zephyr's ADC driver does not expose),
 * so `&adc` is disabled here: Zephyr's ADC driver must not also claim it. The
 * DK's `arduino_adc` connector node keeps referring to it as a plain phandle,
 * which needs no driver.
 */

/ {
	chosen {
		embarch,analog-input = &embarch_analog_a0;
		embarch,marker-input = &embarch_marker;
		embarch,control-link = &cdc_acm_uart0;
	};

	embarch_analog_a0: analog-input-a0 {
		compatible = "embarch,analog-input";
		label = "A0";
		saadc-input = <1>;	/* P0.03 = AIN1 */
		gpios = <&gpio0 3 0>;
	};

	embarch_marker: marker-input {
		compatible = "embarch,marker-input";
		/* BUTTON2 (P0.12), to ground, so active low with the pull-up. */
		gpios = <&gpio0 12 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
	};
};

&adc {
	status = "disabled";
};

&uart0 {
	current-speed = <1000000>;
	hw-flow-control;
};

/*
 * Native USB: three CDC ACM ports on the nRF USB connector (src/usb_device.c).
 * The `label` of each is the port's USB interface string; the order is the
 * port order (cdc_acm_0, cdc_acm_1, cdc_acm_2 in the class registry).
 * The SMP port is the MCUmgr transport: image updates through MCUboot.
 * The control port is the Core link (`embarch,control-link`); the samples
 * port carries the analog stream (src/samples_port.c).
 */
&zephyr_udc0 {
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
		label = "EmbArch control";
	};

	cdc_acm_uart1: cdc_acm_uart1 {
		compatible = "zephyr,cdc-acm-uart";
		label = "EmbArch samples";
	};

	cdc_acm_uart2: cdc_acm_uart2 {
		compatible = "zephyr,cdc-acm-uart";
		label = "EmbArch SMP";
	};
};

/ {
	chosen {
		/* The board file points this at the J-Link UART, which is the
		 * console and the control link. */
		zephyr,uart-mcumgr = &cdc_acm_uart2;
	};
};
