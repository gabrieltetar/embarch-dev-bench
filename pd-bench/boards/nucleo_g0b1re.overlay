/*
 * NUCLEO-G0B1RE: UCPD1 on CC1 PA8 and CC2 PB15, the pins both expansion
 * boards use. The rest comes from the shield (boards/shields/).
 */

&ucpd1 {
	status = "okay";
	/* HSI 16 MHz / 27 = 592.6 kHz half-bit clock, as on the STM32G081B-EVAL */
	psc-ucpdclk = <1>;
	hbitclkdiv = <27>;
	pinctrl-0 = <&ucpd1_cc1_pa8 &ucpd1_cc2_pb15>;
	pinctrl-names = "default";
};
