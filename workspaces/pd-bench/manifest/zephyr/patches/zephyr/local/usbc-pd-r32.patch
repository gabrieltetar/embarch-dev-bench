diff --git a/subsys/usb/usb_c/usbc_timer.c b/subsys/usb/usb_c/usbc_timer.c
index 89e2165f110..5286abf8952 100644
--- a/subsys/usb/usb_c/usbc_timer.c
+++ b/subsys/usb/usb_c/usbc_timer.c
@@ -10,22 +10,46 @@
 #define TIMER_STARTED 0
 /** Timer flag to track if timer has expired */
 #define TIMER_EXPIRED 1
+/** Timer flag to track if the kernel timer was initialized */
+#define TIMER_INITIALIZED 2
 
 /**
  * @brief The timer function that's executed when the timer expires
  */
 static void usbc_timer_handler(struct k_timer *timer)
 {
-	struct usbc_timer_t *usbc_timer = k_timer_user_data_get(timer);
+	struct usbc_timer_t *usbc_timer = CONTAINER_OF(timer, struct usbc_timer_t, timer);
+	struct k_sem *sem = k_timer_user_data_get(timer);
 
 	atomic_set_bit(&usbc_timer->flags, TIMER_EXPIRED);
+	if (sem != NULL) {
+		k_sem_give(sem);
+	}
 }
 
 void usbc_timer_init(struct usbc_timer_t *usbc_timer, uint32_t timeout_ms)
 {
-	k_timer_init(&usbc_timer->timer, usbc_timer_handler, NULL);
-	k_timer_user_data_set(&usbc_timer->timer, usbc_timer);
+	/*
+	 * The state machines initialize their timers again at every attach
+	 * and Protocol Layer reset, possibly while one runs. k_timer_init()
+	 * on a running timer would leave its timeout linked in the kernel's
+	 * timeout list, so the kernel timer is initialized once and only
+	 * stopped afterwards.
+	 */
+	if (atomic_test_bit(&usbc_timer->flags, TIMER_INITIALIZED)) {
+		k_timer_stop(&usbc_timer->timer);
+	} else {
+		k_timer_init(&usbc_timer->timer, usbc_timer_handler, NULL);
+	}
+	k_timer_user_data_set(&usbc_timer->timer, NULL);
+
 	usbc_timer->timeout_ms = timeout_ms;
+	atomic_set(&usbc_timer->flags, BIT(TIMER_INITIALIZED));
+}
+
+void usbc_timer_wake(struct usbc_timer_t *usbc_timer, struct k_sem *sem)
+{
+	k_timer_user_data_set(&usbc_timer->timer, sem);
 }
 
 void usbc_timer_start(struct usbc_timer_t *usbc_timer)
