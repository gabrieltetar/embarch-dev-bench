+/**
+ * @brief PE_SRC_Wait_for_Get_Status State
+ */
+void pe_src_wait_for_get_status_entry(void *obj)
+{
+	struct policy_engine *pe = (struct policy_engine *)obj;
+
+	LOG_INF("PE_SRC_Wait_for_Get_Status");
+
+	/* Initialize and run the SenderResponseTimer */
+	usbc_timer_start(&pe->pd_t_sender_response);
+}
+
+enum smf_state_result pe_src_wait_for_get_status_run(void *obj)
+{
+	struct policy_engine *pe = (struct policy_engine *)obj;
+	const struct device *dev = pe->dev;
+	struct usbc_port_data *data = dev->data;
+	struct protocol_layer_rx_t *prl_rx = data->prl_rx;
+
+	/*
+	 * The Policy Engine Shall transition to PE_Give_Status when a
+	 * Get_Status Message is received; the Alert AMS may also carry a
+	 * Get_Battery_Status (USB PD spec), answered through PE_GIVE_INFO. A
+	 * Not_Supported, from a Sink without the Alert Responder, ends the AMS.
+	 * The Sink cannot start an AMS of its own while Rp is SinkTxNG, so any
+	 * other Message is an Unexpected Message in the Alert AMS, a Protocol
+	 * Error (USB PD spec).
+	 */
+	if (atomic_test_bit(pe->flags, PE_FLAGS_MSG_RECEIVED)) {
+		const union pd_header header = prl_rx->emsg.header;
+
+		if (received_control_message(dev, header, PD_CTRL_GET_STATUS) &&
+		    data->policy_cb_get_status != NULL) {
+			atomic_clear_bit(pe->flags, PE_FLAGS_MSG_RECEIVED);
+			pe_set_state(dev, PE_SRC_GIVE_STATUS);
+		} else if (header.extended && header.message_type == PD_EXT_GET_BATTERY_STATUS) {
+			bool given = pe_give_info_check(dev);
+
+			atomic_clear_bit(pe->flags, PE_FLAGS_MSG_RECEIVED);
+			if (!given) {
+				pe_set_state(dev, PE_SEND_NOT_SUPPORTED);
+			}
+		} else if (received_control_message(dev, header, PD_CTRL_NOT_SUPPORTED)) {
+			atomic_clear_bit(pe->flags, PE_FLAGS_MSG_RECEIVED);
+			policy_notify(dev, MSG_NOT_SUPPORTED_RECEIVED);
+			pe_set_state(dev, PE_SRC_READY);
+		} else {
+			pe_send_soft_reset(dev, prl_rx->emsg.type);
+		}
+	}
+	/*
+	 * The Policy Engine Shall transition back to PE_SRC_Ready when the
+	 * SenderResponseTimer times out.
+	 */
+	else if (usbc_timer_expired(&pe->pd_t_sender_response)) {
+		pe_set_state(dev, PE_SRC_READY);
+	}
+	return SMF_EVENT_PROPAGATE;
+}
+
+void pe_src_wait_for_get_status_exit(void *obj)
+{
+	struct policy_engine *pe = (struct policy_engine *)obj;
+
+	usbc_timer_stop(&pe->pd_t_sender_response);
+}
