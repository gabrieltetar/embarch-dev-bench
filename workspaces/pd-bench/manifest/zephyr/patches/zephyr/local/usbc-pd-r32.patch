+static void pe_prs_send_swap_exit(void *obj)
+{
+	struct policy_engine *pe = (struct policy_engine *)obj;
+
+	usbc_timer_stop(&pe->pd_t_sender_response);
+}
+
+/**
+ * @brief PE_PRS_SRC_SNK_Transition_to_off Entry
+ */
+static void pe_prs_src_snk_transition_to_off_entry(void *obj)
+{
+	struct policy_engine *pe = (struct policy_engine *)obj;
+
+	LOG_INF("PE_PRS_SRC_SNK_Transition_to_off");
+
+	/* The Source waits tSrcTransition before it turns its supply off */
+	usbc_timer_start_with_value(&pe->pd_t_pr_swap, PD_T_SRC_TRANSITION_MIN_MS);
+	pe->submachine = PE_PRS_SM_SRC_TRANSITION;
+}
+
+/**
+ * @brief PE_PRS_SRC_SNK_Transition_to_off Run, with PE_PRS_SRC_SNK_Assert_Rd
+ */
+static enum smf_state_result pe_prs_src_snk_transition_to_off_run(void *obj)
+{
+	struct policy_engine *pe = (struct policy_engine *)obj;
+	const struct device *dev = pe->dev;
+	struct usbc_port_data *data = dev->data;
+
+	if (pe->submachine == PE_PRS_SM_ERROR) {
+		return SMF_EVENT_PROPAGATE;
+	}
+
+	/*
+	 * A Protocol Error during a Power Role Swap, while the power supply is
+	 * in transition, is handled for the port's power role at the time
+	 */
+	if (atomic_test_and_clear_bit(pe->flags, PE_FLAGS_MSG_RECEIVED)) {
+		pe_prs_protocol_error(dev);
+		return SMF_EVENT_PROPAGATE;
+	}
+
+	switch (pe->submachine) {
+	case PE_PRS_SM_SRC_TRANSITION:
+		if (!usbc_timer_expired(&pe->pd_t_pr_swap)) {
+			break;
+		}
+		/*
+		 * Request the Device Policy Manager to turn off the Source.
+		 * tSrcSwapStdby counts from the end of tSrcTransition (USB PD spec),
+		 * however long the request takes.
+		 */
+		usbc_timer_start_with_value(&pe->pd_t_pr_swap, PE_T_SRC_SWAP_STDBY_MS);
+		if (usbc_policy_src_en(dev, data->tcpc, false) != 0) {
+			pe_prs_error_recovery(dev);
+			break;
+		}
+		pe->submachine = PE_PRS_SM_SAFE0V;
+		/* fall through */
+	case PE_PRS_SM_SAFE0V:
+		/* The Source is off, in Swap Standby, once VBUS is at vSafe0V */
+		if (usbc_vbus_check_level(data->vbus, TC_VBUS_SAFE0V)) {
+			/*
+			 * PE_PRS_SRC_SNK_Assert_Rd embedded here. The Explicit
+			 * Contract ends with the Source's supply.
+			 */
+			pe_snk_timers_init(dev);
+			atomic_clear_bit(pe->flags, PE_FLAGS_EXPLICIT_CONTRACT);
+			pe->power_role = TC_ROLE_SINK;
+			if (tc_pr_swap_set_role(dev, TC_ROLE_SINK) != 0) {
+				pe_prs_error_recovery(dev);
+				break;
+			}
+			pe_set_state(dev, PE_PRS_SRC_SNK_WAIT_SOURCE_ON);
+		} else if (usbc_timer_expired(&pe->pd_t_pr_swap)) {
+			pe_prs_error_recovery(dev);
+		}
+		break;
+	default:
+		break;
+	}
+	return SMF_EVENT_PROPAGATE;
+}
+
+/**
+ * @brief PE_PRS_SRC_SNK_Wait_Source_on Entry
+ */
+static void pe_prs_src_snk_wait_source_on_entry(void *obj)
+{
+	struct policy_engine *pe = (struct policy_engine *)obj;
+	const struct device *dev = pe->dev;
+
+	LOG_INF("PE_PRS_SRC_SNK_Wait_Source_on");
+
+	/*
+	 * Send PS_RDY, its Port Power Role now Sink. The PSSourceOnTimer starts
+	 * at its GoodCRC (USB PD spec).
+	 */
+	usbc_timer_stop(&pe->pd_t_pr_swap);
+	pe_send_ctrl_msg(dev, PD_PACKET_SOP, PD_CTRL_PS_RDY);
+	pe->submachine = 0;
+}
+
+/**
+ * @brief PE_PRS_SRC_SNK_Wait_Source_on Run
+ */
+static enum smf_state_result pe_prs_src_snk_wait_source_on_run(void *obj)
+{
+	struct policy_engine *pe = (struct policy_engine *)obj;
+	const struct device *dev = pe->dev;
+	struct usbc_port_data *data = dev->data;
+
+	if (pe->submachine == PE_PRS_SM_ERROR) {
+		return SMF_EVENT_PROPAGATE;
+	}
+
+	/*
+	 * The New Source's PS_RDY ends the swap; a PS_RDY of ours that was not
+	 * sent or the PSSourceOnTimer ends it with ErrorRecovery, and any other
+	 * Message is a Protocol Error for the New Sink.
+	 */
+	if (atomic_test_and_clear_bit(pe->flags, PE_FLAGS_TX_COMPLETE)) {
+		usbc_timer_start_with_value(&pe->pd_t_pr_swap, PD_T_PS_SOURCE_ON_MIN_MS);
+	} else if (atomic_test_and_clear_bit(pe->flags, PE_FLAGS_MSG_XMIT_ERROR) ||
+		   atomic_test_and_clear_bit(pe->flags, PE_FLAGS_MSG_DISCARDED)) {
+		pe_prs_error_recovery(dev);
+	} else if (atomic_test_and_clear_bit(pe->flags, PE_FLAGS_MSG_RECEIVED)) {
+		if (received_control_message(dev, data->prl_rx->emsg.header, PD_CTRL_PS_RDY)) {
+			pe_set_state(dev, PE_SNK_STARTUP);
+		} else {
+			pe_prs_protocol_error(dev);
+		}
+	} else if (usbc_timer_expired(&pe->pd_t_pr_swap)) {
+		pe_prs_error_recovery(dev);
+	}
+	return SMF_EVENT_PROPAGATE;
+}
+
+/**
+ * @brief Exit of the Power Role Swap's power transition, however it ends:
+ *	  done, ErrorRecovery, a reset or a detach
+ */
+static void pe_prs_parent_exit(void *obj)
+{
+	struct policy_engine *pe = (struct policy_engine *)obj;
+
+	usbc_timer_stop(&pe->pd_t_pr_swap);
+	tc_pr_swap_end(pe->dev);
+}
+
+/**
+ * @brief PE_PRS_SNK_SRC_Transition_to_off Entry
+ */
+static void pe_prs_snk_src_transition_to_off_entry(void *obj)
+{
+	struct policy_engine *pe = (struct policy_engine *)obj;
+	const struct device *dev = pe->dev;
+
+	LOG_INF("PE_PRS_SNK_SRC_Transition_to_off");
+
+	/* Run the PSSourceOffTimer and tell the DPM to turn the sink off */
+	usbc_timer_start_with_value(&pe->pd_t_pr_swap, PD_T_PS_SOURCE_OFF_MIN_MS);
+	pe->submachine = 0;
+	policy_notify(dev, POWER_CHANGE_0A0);
+}
+
+/**
+ * @brief PE_PRS_SNK_SRC_Transition_to_off Run, with PE_PRS_SNK_SRC_Assert_Rp
+ */
+static enum smf_state_result pe_prs_snk_src_transition_to_off_run(void *obj)
+{
+	struct policy_engine *pe = (struct policy_engine *)obj;
+	const struct device *dev = pe->dev;
+	struct usbc_port_data *data = dev->data;
+
+	if (pe->submachine == PE_PRS_SM_ERROR) {
+		return SMF_EVENT_PROPAGATE;
+	}
+
+	if (atomic_test_and_clear_bit(pe->flags, PE_FLAGS_MSG_RECEIVED)) {
+		if (!received_control_message(dev, data->prl_rx->emsg.header, PD_CTRL_PS_RDY)) {
+			pe_prs_protocol_error(dev);
+			return SMF_EVENT_PROPAGATE;
+		}
+		/*
+		 * PE_PRS_SNK_SRC_Assert_Rp embedded here. The Explicit Contract
+		 * ended with the Initial Source's supply: until the first new
+		 * one, Rp is the Type-C Current, not Collision Avoidance.
+		 */
+		pe_src_timers_init(dev);
+		atomic_clear_bit(pe->flags, PE_FLAGS_EXPLICIT_CONTRACT);
+		pe->power_role = TC_ROLE_SOURCE;
+		if (tc_pr_swap_set_role(dev, TC_ROLE_SOURCE) != 0) {
+			pe_prs_error_recovery(dev);
+		} else {
+			pe_set_state(dev, PE_PRS_SNK_SRC_SOURCE_ON);
+		}
+	} else if (usbc_timer_expired(&pe->pd_t_pr_swap)) {
+		pe_prs_error_recovery(dev);
+	}
+	return SMF_EVENT_PROPAGATE;
+}
+
+/**
+ * @brief PE_PRS_SNK_SRC_Source_on Entry
+ */
+static void pe_prs_snk_src_source_on_entry(void *obj)
+{
+	struct policy_engine *pe = (struct policy_engine *)obj;
+	const struct device *dev = pe->dev;
+	struct usbc_port_data *data = dev->data;
+
+	LOG_INF("PE_PRS_SNK_SRC_Source_on");
+
+	/* Tell the Device Policy Manager to turn on the Source */
+	usbc_timer_start_with_value(&pe->pd_t_pr_swap, PE_T_SRC_TRANS_ON_MS);
+	pe->submachine = PE_PRS_SM_SAFE5V;
+	if (usbc_policy_src_en(dev, data->tcpc, true) != 0) {
+		pe_prs_error_recovery(dev);
+	}
+}
+
+/**
+ * @brief PE_PRS_SNK_SRC_Source_on Run
+ */
+static enum smf_state_result pe_prs_snk_src_source_on_run(void *obj)
+{
+	struct policy_engine *pe = (struct policy_engine *)obj;
+	const struct device *dev = pe->dev;
+	struct usbc_port_data *data = dev->data;
+
+	switch (pe->submachine) {
+	case PE_PRS_SM_SAFE5V:
+		/*
+		 * Send PS_RDY once VBUS is at vSafe5V, within tSrcTransOn: past
+		 * it, also when turning the Source on took that long, the swap
+		 * ends with ErrorRecovery
+		 */
+		if (atomic_test_and_clear_bit(pe->flags, PE_FLAGS_MSG_RECEIVED)) {
+			pe_prs_protocol_error(dev);
+		} else if (usbc_timer_expired(&pe->pd_t_pr_swap)) {
+			pe_prs_error_recovery(dev);
+		} else if (usbc_vbus_check_level(data->vbus, TC_VBUS_PRESENT)) {
+			pe_send_ctrl_msg(dev, PD_PACKET_SOP, PD_CTRL_PS_RDY);
+			pe->submachine = PE_PRS_SM_PS_RDY;
+		}
+		break;
+	case PE_PRS_SM_PS_RDY:
+		/*
+		 * The swap ends once PS_RDY is sent; one that is not sent ends
+		 * it with ErrorRecovery.
+		 */
+		if (atomic_test_and_clear_bit(pe->flags, PE_FLAGS_TX_COMPLETE)) {
+			atomic_set_bit(pe->flags, PE_FLAGS_PR_SWAP_NEW_SOURCE);
+			pe_set_state(dev, PE_SRC_STARTUP);
+		} else if (atomic_test_and_clear_bit(pe->flags, PE_FLAGS_MSG_XMIT_ERROR) ||
+			   atomic_test_and_clear_bit(pe->flags, PE_FLAGS_MSG_DISCARDED) ||
+			   atomic_test_and_clear_bit(pe->flags, PE_FLAGS_MSG_RECEIVED) ||
+			   usbc_timer_expired(&pe->pd_t_pr_swap)) {
+			/*
+			 * A received Message, a Soft_Reset included, resets the
+			 * Protocol Layer and drops the PS_RDY without a result;
+			 * the timer bounds any lost result
+			 */
+			pe_prs_error_recovery(dev);
+		}
+		break;
+	default:
+		break;
+	}
+	return SMF_EVENT_PROPAGATE;
+}
