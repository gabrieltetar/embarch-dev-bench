+#endif /* CONFIG_USBC_CSM_DRP */
+
+bool pe_bist_check(const struct device *dev)
+{
+	struct usbc_port_data *data = dev->data;
+	struct protocol_layer_rx_t *prl_rx = data->prl_rx;
+	const union pd_header header = prl_rx->emsg.header;
+	const bool source = data->pe->power_role == TC_ROLE_SOURCE;
+	int vbus_mv = 0;
+	uint32_t mode;
+
+	if (header.extended || header.number_of_data_objects == 0 ||
+	    header.message_type != PD_DATA_BIST) {
+		return false;
+	}
+
+	mode = PD_BDO_MODE(sys_get_le32(prl_rx->emsg.data));
+
+	/* Shared Test Mode is left at any VBUS level: the Tester may have raised it */
+	if (source && mode == PD_BDO_MODE_SHARED_EXIT) {
+		policy_notify(dev, BIST_SHARED_TEST_MODE_EXIT);
+		return true;
+	}
+
+	/* Each BIST Test Mode needs VBUS at vSafe5V to start; any other one is ignored */
+	if (usbc_vbus_measure(data->vbus, &vbus_mv) != 0 || vbus_mv < PD_V_SAFE_5V_MIN_MV ||
+	    vbus_mv > PD_V_SAFE_5V_MAX_MV) {
+		return true;
+	}
+
+	if (mode == PD_BDO_MODE_CARRIER) {
+		pe_set_state(dev, PE_BIST_CARRIER_MODE);
+	} else if (mode == PD_BDO_MODE_TEST_DATA) {
+		pe_set_state(dev, PE_BIST_TEST_MODE);
+	} else if (source && mode == PD_BDO_MODE_SHARED_ENTRY) {
+		/* A Shared Capacity Port's Master Port, in PE_SRC_Ready (USB PD spec) */
+		policy_notify(dev, BIST_SHARED_TEST_MODE_ENTRY);
+	}
+
+	return true;
+}
+
+/**
+ * @brief Leave a BIST mode for the Transition_to_default state of the power role
+ */
+static void pe_bist_end(const struct device *dev)
+{
+	struct usbc_port_data *data = dev->data;
+
+#ifdef CONFIG_USBC_CSM_SUPPORTS_SOURCE
+	if (data->pe->power_role == TC_ROLE_SOURCE) {
+		pe_set_state(dev, PE_SRC_TRANSITION_TO_DEFAULT);
+		return;
+	}
+#endif
+#ifdef CONFIG_USBC_CSM_SUPPORTS_SINK
+	pe_set_state(dev, PE_SNK_TRANSITION_TO_DEFAULT);
+#endif
+	ARG_UNUSED(data);
+}
