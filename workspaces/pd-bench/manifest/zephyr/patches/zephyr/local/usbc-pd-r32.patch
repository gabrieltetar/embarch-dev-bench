+/**
+ * @brief 9.2.26.4.1.1 PE_BIST_Carrier_Mode State
+ */
+static void pe_bist_carrier_mode_entry(void *obj)
+{
+	struct policy_engine *pe = (struct policy_engine *)obj;
+	const struct device *dev = pe->dev;
+	struct usbc_port_data *data = dev->data;
+	struct pd_msg *msg = &data->prl_tx->emsg;
+
+	LOG_INF("PE_BIST_Carrier_Mode");
+
+	/* Tell the PHY Layer to go to BIST Carrier Mode, and run the BISTContModeTimer */
+	msg->type = PD_PACKET_TX_BIST_MODE_2;
+	msg->header.raw_value = 0;
+	msg->len = 0;
+	tcpc_transmit_data(data->tcpc, msg);
+	usbc_timer_start(&pe->pd_t_bist_cont_mode);
+}
+
+static enum smf_state_result pe_bist_carrier_mode_run(void *obj)
+{
+	struct policy_engine *pe = (struct policy_engine *)obj;
+	const struct device *dev = pe->dev;
+
+	/* The carrier ends, and the port goes to its default level, at the timeout */
+	if (usbc_timer_expired(&pe->pd_t_bist_cont_mode)) {
+		pe_bist_end(dev);
+	}
+	return SMF_EVENT_PROPAGATE;
+}
+
+static void pe_bist_carrier_mode_exit(void *obj)
+{
+	struct policy_engine *pe = (struct policy_engine *)obj;
+	struct usbc_port_data *data = pe->dev->data;
+
+	/* Stop the carrier however the state is left: a reset or a detach too */
+	usbc_timer_stop(&pe->pd_t_bist_cont_mode);
+	tcpc_set_bist_test_mode(data->tcpc, false);
+}
+
+/**
+ * @brief 9.2.26.4.2.1 PE_BIST_Test_Mode State
+ */
+static void pe_bist_test_mode_entry(void *obj)
+{
+	struct policy_engine *pe = (struct policy_engine *)obj;
+	struct usbc_port_data *data = pe->dev->data;
+
+	LOG_INF("PE_BIST_Test_Mode");
+
+	/*
+	 * Tell the Protocol Layer to send no Message but GoodCRC until a Hard
+	 * Reset, which leaves this state
+	 */
+	tcpc_set_bist_test_mode(data->tcpc, true);
+}
+
+static void pe_bist_test_mode_exit(void *obj)
+{
+	struct policy_engine *pe = (struct policy_engine *)obj;
+	struct usbc_port_data *data = pe->dev->data;
+
+	tcpc_set_bist_test_mode(data->tcpc, false);
+}
