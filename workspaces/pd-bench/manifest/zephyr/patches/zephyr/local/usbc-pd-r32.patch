+		ext_data = &scedb;
+	} else if (header.message_type == PD_CTRL_GET_STATUS) {
+		data->policy_cb_get_status(dev, &sdb);
+		ext_header.data_size = sizeof(sdb);
+		ext_data = &sdb;
+	} else if (header.message_type == PD_CTRL_GET_REVISION) {
+		dos[0] = PE_REVISION_RMDO;
+		msg->len = sizeof(dos[0]);
+		memcpy(msg->data, dos, msg->len);
+		pe_send_data_msg(dev, PD_PACKET_SOP, PD_DATA_REVISION);
+		return;
+	} else if (header.message_type == PD_CTRL_GET_SOURCE_INFO) {
+		data->policy_cb_get_src_info(dev, (union pd_sido1 *)&dos[0],
+					     (union pd_sido2 *)&dos[1]);
+		msg->len = sizeof(dos);
+		memcpy(msg->data, dos, msg->len);
+		pe_send_data_msg(dev, PD_PACKET_SOP, PD_DATA_SOURCE_INFO);
+		return;
+	}
+#ifdef CONFIG_USBC_CSM_DRP
+	else if (header.message_type == PD_CTRL_GET_SOURCE_CAP) {
+		const uint32_t *pdos;
+		uint32_t num_pdos = 0;
 
-	/* Reset the protocol layer */
-	prl_reset(dev);
+		data->policy_cb_get_src_caps(dev, &pdos, &num_pdos);
+		pe_send_caps_msg(dev, PD_DATA_SOURCE_CAP, pdos, num_pdos);
+		return;
+	} else {
+		uint32_t *pdos;
+		int num_pdos = 0;
+
+		policy_get_snk_cap(dev, &pdos, &num_pdos);
+		pe_send_caps_msg(dev, PD_DATA_SINK_CAP, pdos, num_pdos);
+		return;
+	}
+#endif
+
+	pe_send_ext_msg(dev, PD_PACKET_SOP,
+			header.extended && header.message_type == PD_EXT_GET_BATTERY_CAP
+				? PD_EXT_BATTERY_CAP
+			: header.extended                                     ? PD_EXT_MANUFACTURER_INFO
+			: header.message_type == PD_CTRL_GET_STATUS         ? PD_EXT_STATUS
+			: header.message_type == PD_CTRL_GET_SOURCE_CAP_EXT ? PD_EXT_SOURCE_CAP
+									      : PD_EXT_SINK_CAP_EXT,
+			ext_data, ext_header.data_size);
+}
+
+/**
+ * @brief PE_GIVE_INFO Run state
+ */
+static enum smf_state_result pe_give_info_run(void *obj)
+{
+	struct policy_engine *pe = (struct policy_engine *)obj;
+	const struct device *dev = pe->dev;
+	struct usbc_port_data *data = dev->data;
+	struct protocol_layer_tx_t *prl_tx = data->prl_tx;
+
+	/*
+	 * Back to the Ready state once the reply is sent. A Message that
+	 * discarded it came while the partner's AMS waited for the reply, and a
+	 * transmission error left it unsent: both are Protocol Errors (USB PD
+	 * spec).
+	 */
+	if (atomic_test_and_clear_bit(pe->flags, PE_FLAGS_TX_COMPLETE)) {
+		/* A sent Status clears the Event Flags it reported */
+		if (prl_tx->extended && prl_tx->msg_type == PD_EXT_STATUS) {
+			policy_notify(dev, STATUS_SENT);
+		}
+		pe_set_ready_state(dev);
+	} else if (atomic_test_and_clear_bit(pe->flags, PE_FLAGS_MSG_DISCARDED) ||
+		   atomic_test_and_clear_bit(pe->flags, PE_FLAGS_MSG_XMIT_ERROR)) {
+		pe_send_soft_reset(dev, PD_PACKET_SOP);
+	}
+	return SMF_EVENT_PROPAGATE;
+}
+
+bool pe_msg_unexpected(const struct device *dev)
+{
+	struct usbc_port_data *data = dev->data;
+	const union pd_header header = data->prl_rx->emsg.header;
+
+	/*
+	 * At PD Revision 2.0 Extended Messages and Battery_Status are Reserved:
+	 * unsupported there, answered with Reject (USB PD spec)
+	 */
+	if (prl_get_rev(dev, PD_PACKET_SOP) < PD_REV30 &&
+	    (header.extended || header.message_type == PD_DATA_BATTERY_STATUS)) {
+		return false;
+	}
+
+	if (header.extended) {
+		return (header.message_type == PD_EXT_STATUS && data->policy_cb_set_status != NULL) ||
+		       (header.message_type == PD_EXT_PPS_STATUS &&
+			data->policy_cb_set_pps_status != NULL);
+	}
+
+	switch (header.message_type) {
+	case PD_DATA_BATTERY_STATUS:
+		return data->policy_cb_set_battery_status != NULL;
+	case PD_DATA_SOURCE_CAP:
+		return IS_ENABLED(CONFIG_USBC_CSM_SUPPORTS_SINK) &&
+		       data->pe->power_role == TC_ROLE_SOURCE;
+	case PD_DATA_REQUEST:
+		return IS_ENABLED(CONFIG_USBC_CSM_SUPPORTS_SOURCE) &&
+		       data->pe->power_role == TC_ROLE_SINK;
+	case PD_DATA_SINK_CAP:
+		return IS_ENABLED(CONFIG_USBC_CSM_SUPPORTS_SOURCE);
+	default:
+		return false;
+	}
+}
+
+bool pe_alert_check(const struct device *dev)
+{
+	struct usbc_port_data *data = dev->data;
+	struct protocol_layer_rx_t *prl_rx = data->prl_rx;
+	const union pd_header header = prl_rx->emsg.header;
+	uint32_t batteries;
+	uint32_t ado;
+
+	if (header.extended || header.number_of_data_objects != 1 ||
+	    header.message_type != PD_DATA_ALERT || data->policy_cb_alert_received == NULL ||
+	    prl_get_rev(dev, PD_PACKET_SOP) < PD_REV30) {
+		return false;
+	}
+
+	/*
+	 * PE_SNK_Source_Alert_Received and PE_SRC_Sink_Alert_Received embedded
+	 * here: inform the DPM of the Alert, and get the partner's Status if
+	 * it asks for it. That Get_Status continues the partner's Alert AMS
+	 * (USB PD spec), so it starts no AMS of ours.
+	 */
+	ado = sys_get_le32(prl_rx->emsg.data);
+	batteries = FIELD_GET(PD_ADO_FIXED_BATTERIES, ado) |
+		    FIELD_GET(PD_ADO_HOT_SWAPPABLE_BATTERIES, ado) << PE_FIXED_BATTERY_SLOTS;
+	/* The battery fields are Reserved without a Battery Status Change (USB PD spec) */
+	if ((ado & PD_ADO_BATTERY_STATUS_CHANGE_EVENT) != 0U) {
+		data->pe->battery_ref = batteries != 0 ? find_lsb_set(batteries) - 1 : 0;
+	}
+	if (data->policy_cb_alert_received(dev, ado)) {
+		data->pe->alert_reply = true;
+		pe_set_state(dev, PE_GET_STATUS);
+	}
+
+	return true;
+}
+
+/**
+ * @brief Submachine value once PE_Get_Status or PE_SNK_Get_PPS_Status reported
+ */
+#define PE_GET_STATUS_REPORTED (SM_WAIT_FOR_RX + 1)
+
+/**
+ * @brief Report a requested Status or PPS Status to the DPM, NULL for none
+ */
+static void pe_get_status_report(const struct device *dev, const uint8_t *block, uint32_t size)
+{
+	struct usbc_port_data *data = dev->data;
+	struct pd_sdb sdb = {0};
+	union pd_ppssdb ppssdb = {.raw_value = 0};
+
+	data->pe->submachine = PE_GET_STATUS_REPORTED;
+
+	if (pe_get_state(dev) == PE_GET_BATTERY_STATUS) {
+		union pd_bsdo bsdo = {.raw_value = 0};
+
+		if (data->policy_cb_set_battery_status == NULL) {
+			return;
+		}
+		if (block != NULL) {
+			memcpy(&bsdo.raw_value, block, MIN(size, sizeof(bsdo.raw_value)));
+		}
+		data->policy_cb_set_battery_status(dev, block != NULL ? &bsdo : NULL);
+	} else if (pe_get_state(dev) == PE_GET_STATUS) {
+		if (data->policy_cb_set_status == NULL) {
+			return;
+		}
+		if (block != NULL) {
+			memcpy(&sdb, block, MIN(size, sizeof(sdb)));
+		}
+		data->policy_cb_set_status(dev, block != NULL ? &sdb : NULL);
+	} else {
+		if (data->policy_cb_set_pps_status == NULL) {
+			return;
+		}
+		if (block != NULL) {
+			memcpy(&ppssdb.raw_value, block, MIN(size, sizeof(ppssdb.raw_value)));
+		}
+		data->policy_cb_set_pps_status(dev, block != NULL ? &ppssdb : NULL);
+	}
+}
+
+/**
+ * @brief PE_Get_Status and PE_SNK_Get_PPS_Status Entry state
+ */
+static void pe_get_status_entry(void *obj)
+{
+	struct policy_engine *pe = (struct policy_engine *)obj;
+	const struct device *dev = pe->dev;
+	const enum usbc_pe_state state = pe_get_state(dev);
+
+	pe->submachine = SM_WAIT_FOR_TX;
+
+	/* Send the request; the SenderResponseTimer starts at its GoodCRC */
+	if (state == PE_GET_BATTERY_STATUS) {
+		LOG_INF("PE_Get_Battery_Status");
+		pe_send_ext_msg(dev, PD_PACKET_SOP, PD_EXT_GET_BATTERY_STATUS, &pe->battery_ref,
+				sizeof(pe->battery_ref));
+		return;
+	}
+
+	LOG_INF("PE_%s", state == PE_GET_STATUS ? "Get_Status" : "SNK_Get_PPS_Status");
+	pe_send_ctrl_msg(dev, PD_PACKET_SOP,
+			 state == PE_GET_STATUS ? PD_CTRL_GET_STATUS : PD_CTRL_GET_PPS_STATUS);
+}
+
+/**
+ * @brief PE_Get_Status and PE_SNK_Get_PPS_Status Run state
+ */
+static enum smf_state_result pe_get_status_run(void *obj)
+{
+	struct policy_engine *pe = (struct policy_engine *)obj;
+	const struct device *dev = pe->dev;
+	struct usbc_port_data *data = dev->data;
+	struct protocol_layer_rx_t *prl_rx = data->prl_rx;
+	const enum pd_ext_msg_type reply =
+		pe_get_state(dev) == PE_GET_STATUS ? PD_EXT_STATUS : PD_EXT_PPS_STATUS;
+	const bool battery = pe_get_state(dev) == PE_GET_BATTERY_STATUS;
+	union pd_ext_header ext_header;
+	union pd_header header;
+
+	switch (pe->submachine) {
+	case SM_WAIT_FOR_TX:
+		/*
+		 * The Message that discarded a request the DPM started is handled
+		 * in the Ready state. A Get_Status that answers the partner's
+		 * Alert is not the first Message of an AMS: a Message that
+		 * discards it is a Protocol Error (USB PD spec).
+		 */
+		if (atomic_test_and_clear_bit(pe->flags, PE_FLAGS_MSG_DISCARDED)) {
+			pe_get_status_report(dev, NULL, 0);
+			if (pe->alert_reply) {
+				pe_send_soft_reset(dev, PD_PACKET_SOP);
+			} else {
+				policy_notify(dev, MSG_DISCARDED);
+				pe_set_ready_state(dev);
+			}
+			break;
+		}
+		/* A request that was not sent is a Protocol Error */
+		if (atomic_test_and_clear_bit(pe->flags, PE_FLAGS_MSG_XMIT_ERROR)) {
+			pe_get_status_report(dev, NULL, 0);
+			pe_send_soft_reset(dev, PD_PACKET_SOP);
+			break;
+		}
+		if (!atomic_test_and_clear_bit(pe->flags, PE_FLAGS_TX_COMPLETE)) {
+			break;
+		}
+		usbc_timer_start(&pe->pd_t_sender_response);
+		pe->submachine = SM_WAIT_FOR_RX;
+		/* fall through */
+	case SM_WAIT_FOR_RX:
+		if (atomic_test_and_clear_bit(pe->flags, PE_FLAGS_MSG_RECEIVED)) {
+			header = prl_rx->emsg.header;
+
+			/*
+			 * Back to the Ready state with the reply, or with a
+			 * Not_Supported or Reject; any other Message is a
+			 * Protocol Error in this AMS (USB PD spec).
+			 */
+			if (battery && prl_rx->emsg.type == PD_PACKET_SOP && !header.extended &&
+			    header.number_of_data_objects == 1 &&
+			    header.message_type == PD_DATA_BATTERY_STATUS) {
+				pe_get_status_report(dev, prl_rx->emsg.data, sizeof(uint32_t));
+				pe_set_ready_state(dev);
+			} else if (!battery && prl_rx->emsg.type == PD_PACKET_SOP &&
+				   header.extended && header.message_type == reply &&
+				   pe_rx_single_chunk(dev, &ext_header)) {
+				pe_get_status_report(
+					dev, prl_rx->emsg.data + sizeof(ext_header.raw_value),
+					MIN(ext_header.data_size,
+					    prl_rx->emsg.len - sizeof(ext_header.raw_value)));
+				pe_set_ready_state(dev);
+			} else if (prl_rx->emsg.type == PD_PACKET_SOP &&
+				   (received_control_message(dev, header, PD_CTRL_NOT_SUPPORTED) ||
+				    received_control_message(dev, header, PD_CTRL_REJECT))) {
+				pe_get_status_report(dev, NULL, 0);
+				pe_set_ready_state(dev);
+			} else {
+				pe_get_status_report(dev, NULL, 0);
+				pe_send_soft_reset(dev, PD_PACKET_SOP);
+			}
+		} else if (usbc_timer_expired(&pe->pd_t_sender_response)) {
+			pe_get_status_report(dev, NULL, 0);
+			pe_set_ready_state(dev);
+		}
+		break;
+	}
+	return SMF_EVENT_PROPAGATE;
+}
+
+static void pe_get_status_exit(void *obj)
+{
+	struct policy_engine *pe = (struct policy_engine *)obj;
+
+	usbc_timer_stop(&pe->pd_t_sender_response);
+	pe->alert_reply = false;
+
+	/* The DPM Shall learn the outcome on exit, also of a reset or detach */
+	if (pe->submachine != PE_GET_STATUS_REPORTED) {
+		pe_get_status_report(pe->dev, NULL, 0);
+	}
+}
+
+#ifdef CONFIG_USBC_CSM_DRP
+
+/*
+ * Times of the Power Role Swap steps. The Policy Engine starts a timer, and
+ * sees it expire, one state machine cycle late at the most: a minimum is
+ * used as is, a maximum less two cycles.
+ */
+#define PE_T_CYCLES_MS (2 * CONFIG_USBC_STATE_MACHINE_CYCLE_TIME)
+#define PE_T_SRC_SWAP_STDBY_MS (PD_T_SRC_SWAP_STDBY_MAX_MS - PE_T_CYCLES_MS)
+#define PE_T_SRC_TRANS_ON_MS (PD_T_SRC_TRANS_ON_MAX_MS - PE_T_CYCLES_MS)
+
+BUILD_ASSERT(PD_T_PS_SOURCE_ON_MIN_MS + PE_T_CYCLES_MS <= PD_T_PS_SOURCE_ON_MAX_MS &&
+		     PD_T_PS_SOURCE_OFF_MIN_MS + PE_T_CYCLES_MS <= PD_T_PS_SOURCE_OFF_MAX_MS,
+	     "the state machine cycle is too long for the Power Role Swap timers");
+
+/**
+ * @brief Submachine of the Power Role Swap states
+ */
+enum pe_prs_submachine {
+	/* The Initial Source waits tSrcTransition */
+	PE_PRS_SM_SRC_TRANSITION,
+	/* The Initial Source waits for VBUS at vSafe0V */
+	PE_PRS_SM_SAFE0V,
+	/* The New Source waits for VBUS at vSafe5V */
+	PE_PRS_SM_SAFE5V,
+	/* The New Source waits for its PS_RDY to be sent */
+	PE_PRS_SM_PS_RDY,
+	/* ErrorRecovery was requested */
+	PE_PRS_SM_ERROR,
+};
+
+/**
+ * @brief End a Power Role Swap that failed with ErrorRecovery. A Soft Reset
+ *	  Shall Not be initiated.
+ */
+static void pe_prs_error_recovery(const struct device *dev)
+{
+	struct usbc_port_data *data = dev->data;
+
+	LOG_ERR("Power Role Swap failed: ErrorRecovery");
+	data->pe->submachine = PE_PRS_SM_ERROR;
+	/* The DPM learns the swap failed before the port detaches */
+	policy_notify(dev, PROTOCOL_ERROR);
+	/*
+	 * The swap stays on until the Type-C layer takes the request: ending
+	 * it here would let a VBUS loss read as a Detach first
+	 */
+	usbc_request(dev, REQUEST_TC_ERROR_RECOVERY);
+}
+
+/**
+ * @brief A Protocol Error while the power supply is in transition during a
+ *	  Power Role Swap: USB Type-C Error Recovery for a port in the Source
+ *	  role, Hard Reset for one in the Sink role (USB PD
+ *	  specification)
+ */
+static void pe_prs_protocol_error(const struct device *dev)
+{
+	struct usbc_port_data *data = dev->data;
+
+	if (data->pe->power_role == TC_ROLE_SOURCE) {
+		pe_prs_error_recovery(dev);
+	} else {
+		LOG_ERR("Power Role Swap failed: Hard Reset");
+		pe_set_hard_reset_state(dev);
+	}
+}
+
+/**
+ * @brief Start the power transition of an accepted Power Role Swap
+ */
+static void pe_prs_start(const struct device *dev)
+{
+	struct usbc_port_data *data = dev->data;
+
+	tc_pr_swap_start(dev);
+	pe_set_state(dev, data->pe->power_role == TC_ROLE_SOURCE
+				  ? PE_PRS_SRC_SNK_TRANSITION_TO_OFF
+				  : PE_PRS_SNK_SRC_TRANSITION_TO_OFF);
+}
+
+bool pe_prs_dpm_request(const struct device *dev)
+{
+	struct usbc_port_data *data = dev->data;
+	struct policy_engine *pe = data->pe;
+
+	if (!pe_dpm_take(pe, REQUEST_PE_PR_SWAP)) {
+		return false;
+	}
+
+	/*
+	 * No PR_Swap again after a Reject until the next Explicit Contract
+	 * negotiation, nor within tPRSwapWait of a Wait (USB PD spec)
+	 */
+	if (atomic_test_bit(pe->flags, PE_FLAGS_PR_SWAP_REJECTED) ||
+	    (usbc_timer_running(&pe->pd_t_pr_swap) && !usbc_timer_expired(&pe->pd_t_pr_swap))) {
+		LOG_INF("PR_Swap not sent after a Reject or a Wait");
+		return true;
+	}
+
+	atomic_set_bit(pe->flags, PE_FLAGS_DPM_INITIATED_AMS);
+	pe_set_state(dev, PE_PRS_SEND_SWAP);
+
+	return true;
+}
+
+/**
+ * @brief PE_PRS_SRC_SNK_Evaluate_Swap and PE_PRS_SNK_SRC_Evaluate_Swap Entry
+ */
+static void pe_prs_evaluate_swap_entry(void *obj)
+{
+	struct policy_engine *pe = (struct policy_engine *)obj;
+	const struct device *dev = pe->dev;
+
+	LOG_INF("PE_PRS_Evaluate_Swap");
+
+	/*
+	 * Ask the Device Policy Manager whether a Power Role Swap can be made.
+	 * PE_PRS_*_Accept_Swap and PE_PRS_*_Reject_Swap embedded here.
+	 */
+	pe_send_ctrl_msg(dev, PD_PACKET_SOP,
+			 policy_check(dev, CHECK_POWER_ROLE_SWAP) ? PD_CTRL_ACCEPT : PD_CTRL_REJECT);
+}
+
+/**
+ * @brief PE_PRS_SRC_SNK_Evaluate_Swap and PE_PRS_SNK_SRC_Evaluate_Swap Run
+ */
+static enum smf_state_result pe_prs_evaluate_swap_run(void *obj)
+{
+	struct policy_engine *pe = (struct policy_engine *)obj;
+	const struct device *dev = pe->dev;
+	struct usbc_port_data *data = dev->data;
+
+	/*
+	 * Once the Accept is sent the power transition starts; once the Reject
+	 * is sent the port is back in its Ready state.
+	 */
+	if (atomic_test_and_clear_bit(pe->flags, PE_FLAGS_TX_COMPLETE)) {
+		if (data->prl_tx->msg_type == PD_CTRL_ACCEPT) {
+			pe_prs_start(dev);
+		} else {
+			pe_set_ready_state(dev);
+		}
+	} else if (atomic_test_and_clear_bit(pe->flags, PE_FLAGS_MSG_DISCARDED) ||
+		   atomic_test_and_clear_bit(pe->flags, PE_FLAGS_MSG_XMIT_ERROR)) {
+		/* A reply that a Message discarded or that was not sent is a Protocol Error */
+		pe_send_soft_reset(dev, PD_PACKET_SOP);
+	}
+	return SMF_EVENT_PROPAGATE;
+}
+
+/**
+ * @brief PE_PRS_SRC_SNK_Send_Swap and PE_PRS_SNK_SRC_Send_Swap Entry
+ */
+static void pe_prs_send_swap_entry(void *obj)
+{
+	struct policy_engine *pe = (struct policy_engine *)obj;
+	const struct device *dev = pe->dev;
+
+	LOG_INF("PE_PRS_Send_Swap");
+
+	/* Send a PR_Swap, then initialize and run the SenderResponseTimer */
+	pe_send_ctrl_msg(dev, PD_PACKET_SOP, PD_CTRL_PR_SWAP);
+	pe->submachine = SM_WAIT_FOR_TX;
+}
+
+/**
+ * @brief PE_PRS_SRC_SNK_Send_Swap and PE_PRS_SNK_SRC_Send_Swap Run
+ */
+static enum smf_state_result pe_prs_send_swap_run(void *obj)
+{
+	struct policy_engine *pe = (struct policy_engine *)obj;
+	const struct device *dev = pe->dev;
+	struct usbc_port_data *data = dev->data;
+	union pd_header header;
+
+	switch (pe->submachine) {
+	case SM_WAIT_FOR_TX:
+		/* The Message that discarded the PR_Swap is handled in the Ready state */
+		if (atomic_test_and_clear_bit(pe->flags, PE_FLAGS_MSG_DISCARDED)) {
+			policy_notify(dev, MSG_DISCARDED);
+			pe_set_ready_state(dev);
+			break;
+		}
+		/* A PR_Swap that was not sent is a Protocol Error */
+		if (atomic_test_and_clear_bit(pe->flags, PE_FLAGS_MSG_XMIT_ERROR)) {
+			pe_send_soft_reset(dev, PD_PACKET_SOP);
+			break;
+		}
+		if (!atomic_test_and_clear_bit(pe->flags, PE_FLAGS_TX_COMPLETE)) {
+			break;
+		}
+		usbc_timer_start(&pe->pd_t_sender_response);
+		pe->submachine = SM_WAIT_FOR_RX;
+		/* fall through */
+	case SM_WAIT_FOR_RX:
+		if (atomic_test_and_clear_bit(pe->flags, PE_FLAGS_MSG_RECEIVED)) {
+			header = data->prl_rx->emsg.header;
+
+			if (received_control_message(dev, header, PD_CTRL_ACCEPT)) {
+				pe_prs_start(dev);
+			} else if (received_control_message(dev, header, PD_CTRL_REJECT) ||
+				   received_control_message(dev, header, PD_CTRL_NOT_SUPPORTED)) {
+				/*
+				 * A partner that cannot swap answers Not_Supported
+				 * (Unsupported Sequence): like a Reject,
+				 * no PR_Swap again until the next contract
+				 */
+				atomic_set_bit(pe->flags, PE_FLAGS_PR_SWAP_REJECTED);
+				policy_notify(dev, received_control_message(dev, header,
+									    PD_CTRL_REJECT)
+							   ? MSG_REJECTED_RECEIVED
+							   : MSG_NOT_SUPPORTED_RECEIVED);
+				pe_set_ready_state(dev);
+			} else if (received_control_message(dev, header, PD_CTRL_WAIT)) {
+				(void)policy_wait_notify(dev, WAIT_POWER_ROLE_SWAP);
+				usbc_timer_start_with_value(&pe->pd_t_pr_swap,
+							    PD_T_PR_SWAP_WAIT_MIN_MS);
+				pe_set_ready_state(dev);
+			} else {
+				/* Any other reply is a Protocol Error (USB PD spec) */
+				pe_send_soft_reset(dev, PD_PACKET_SOP);
+			}
+		} else if (usbc_timer_expired(&pe->pd_t_sender_response)) {
+			/* The DPM learns that no swap follows */
+			policy_notify(dev, SENDER_RESPONSE_TIMEOUT);
+			pe_set_ready_state(dev);
+		}
+		break;
+	}
+	return SMF_EVENT_PROPAGATE;
+}
