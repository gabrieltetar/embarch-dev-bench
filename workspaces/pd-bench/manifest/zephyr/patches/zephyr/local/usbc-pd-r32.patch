+	struct usbc_port_data *data = dev->data;
+	const struct device *tcpc = data->tcpc;
+	enum tc_rp_value rp = TC_RP_USB;
+	int ret;
+
+	if (role == TC_ROLE_SINK) {
+		ret = tcpc_set_cc(tcpc, TC_CC_RD);
+	} else {
+		if (data->policy_cb_get_src_rp != NULL) {
+			data->policy_cb_get_src_rp(dev, &rp);
+		}
+		ret = tcpc_select_rp_value(tcpc, rp);
+		if (ret == -ENOTSUP) {
+			ret = 0;
+		}
+		if (ret == 0) {
+			ret = tcpc_set_cc(tcpc, TC_CC_RP);
+		}
+	}
+
+	if (ret != 0) {
+		LOG_ERR("Couldn't set CC lines for the power role swap: %d", ret);
+		return ret;
+	}
+
+	tc_set_state(dev, role == TC_ROLE_SINK ? TC_ATTACHED_SNK_STATE : TC_ATTACHED_SRC_STATE);
+
+	return 0;
+}
+
+void tc_pr_swap_end(const struct device *dev)
+{
