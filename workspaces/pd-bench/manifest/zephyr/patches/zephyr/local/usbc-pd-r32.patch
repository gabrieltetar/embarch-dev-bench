+/**
+ * @brief Send a Capabilities Message
+ */
+void pe_send_caps_msg(const struct device *dev, const enum pd_data_msg_type msg,
+		      const uint32_t *pdos, uint32_t num_pdos)
+{
+	struct usbc_port_data *data = dev->data;
+	struct pd_msg *emsg = &data->prl_tx->emsg;
+	uint32_t num = 0;
+
+	/*
+	 * All data in all Messages Shall be consistent with the Specification
+	 * Revision they are sent at (USB PD spec): PD 2.0 has no APDO.
+	 */
+	while (num < num_pdos) {
+		union pd_fixed_supply_pdo_source pdo = {.raw_value = pdos[num]};
+
+		if (pdo.type == PDO_AUGMENTED && prl_get_rev(dev, PD_PACKET_SOP) < PD_REV30) {
+			LOG_DBG("%u APDOs not sent at PD 2.0", num_pdos - num);
+			break;
+		}
+		num++;
+	}
+
+	emsg->len = PD_CONVERT_PD_HEADER_COUNT_TO_BYTES(num);
+	memcpy(emsg->data, pdos, emsg->len);
+#ifdef CONFIG_USBC_CSM_SUPPORTS_SOURCE
+	if (msg == PD_DATA_SOURCE_CAP) {
+		union pd_fixed_supply_pdo_source pdo = {.raw_value = num > 0 ? pdos[0] : 0};
+
+		data->pe->src_caps_staged = num;
+		data->pe->src_caps_drd = pdo.dual_role_data;
+	}
+#endif
+	pe_send_data_msg(dev, PD_PACKET_SOP, msg);
+}
