+/**
+ * @brief PE_SRC_Give_PPS_Status State
+ */
+void pe_src_give_pps_status_entry(void *obj)
+{
+	struct policy_engine *pe = (struct policy_engine *)obj;
+	const struct device *dev = pe->dev;
+	struct usbc_port_data *data = dev->data;
+	union pd_ppssdb ppssdb = {.raw_value = 0};
+	uint8_t block[sizeof(ppssdb.raw_value)];
+
+	LOG_INF("PE_SRC_Give_PPS_Status");
+
+	/* Get the present PPS Status from the Device Policy Manager */
+	data->policy_cb_get_pps_status(dev, &ppssdb);
+
+	sys_put_le32(ppssdb.raw_value, block);
+	pe_send_ext_msg(dev, PD_PACKET_SOP, PD_EXT_PPS_STATUS, block, sizeof(block));
+}
+
+enum smf_state_result pe_src_give_pps_status_run(void *obj)
+{
+	struct policy_engine *pe = (struct policy_engine *)obj;
+	const struct device *dev = pe->dev;
+
+	/*
+	 * Wait until message is sent or dropped. A Message that discarded it, or
+	 * a transmission error, is a Protocol Error (USB PD spec).
+	 */
+	if (atomic_test_and_clear_bit(pe->flags, PE_FLAGS_TX_COMPLETE)) {
+		pe_set_state(dev, PE_SRC_READY);
+	} else if (atomic_test_and_clear_bit(pe->flags, PE_FLAGS_MSG_DISCARDED) ||
+		   atomic_test_and_clear_bit(pe->flags, PE_FLAGS_MSG_XMIT_ERROR)) {
+		pe_send_soft_reset(dev, PD_PACKET_SOP);
+	}
+	return SMF_EVENT_PROPAGATE;
+}
+
+/**
+ * @brief PE_SRC_Send_Source_Alert State
+ */
+void pe_src_send_source_alert_entry(void *obj)
+{
+	struct policy_engine *pe = (struct policy_engine *)obj;
+	const struct device *dev = pe->dev;
+	struct usbc_port_data *data = dev->data;
+	struct protocol_layer_tx_t *prl_tx = data->prl_tx;
+	struct pd_msg *msg = &prl_tx->emsg;
+	uint32_t ado;
+
+	LOG_INF("PE_SRC_Send_Source_Alert");
+
+	/* Get the Alert Data Object from the Device Policy Manager */
+	ado = data->policy_cb_get_alert(dev);
+
+	/* An Alert is only sent for a status change: with no event left, send none */
+	pe->submachine = ado == 0;
+	if (ado == 0) {
+		pe_set_state(dev, PE_SRC_READY);
+		return;
+	}
+
+	msg->len = sizeof(ado);
+	sys_put_le32(ado, msg->data);
+	pe_send_data_msg(dev, PD_PACKET_SOP, PD_DATA_ALERT);
+}
+
+enum smf_state_result pe_src_send_source_alert_run(void *obj)
+{
+	struct policy_engine *pe = (struct policy_engine *)obj;
+	const struct device *dev = pe->dev;
+
+	/*
+	 * The Policy Engine Shall transition to the PE_SRC_Wait_for_Get_Status
+	 * state when the Alert Message has been sent. An Alert that a Message
+	 * from the Sink discarded goes back to PE_SRC_Ready, which handles
+	 * that Message; one that is not sent is a Protocol Error.
+	 */
+	if (atomic_test_and_clear_bit(pe->flags, PE_FLAGS_TX_COMPLETE)) {
+		pe->submachine = 1;
+		pe_set_state(dev, PE_SRC_WAIT_FOR_GET_STATUS);
+	} else if (atomic_test_and_clear_bit(pe->flags, PE_FLAGS_MSG_DISCARDED)) {
+		pe_set_state(dev, PE_SRC_READY);
+	} else if (atomic_test_and_clear_bit(pe->flags, PE_FLAGS_MSG_XMIT_ERROR)) {
+		pe_send_soft_reset(dev, PD_PACKET_SOP);
+	}
+	return SMF_EVENT_PROPAGATE;
+}
+
+void pe_src_send_source_alert_exit(void *obj)
+{
+	struct policy_engine *pe = (struct policy_engine *)obj;
+
+	/*
+	 * The Alert's events are the DPM's until the Alert is sent (USB PD spec): an
+	 * Alert left unsent, by a discard, an error, a reset or a detach, goes
+	 * back to the DPM, which may ask for it again.
+	 */
+	if (pe->submachine == 0) {
+		policy_notify(pe->dev, ALERT_DISCARDED);
+	}
+}
